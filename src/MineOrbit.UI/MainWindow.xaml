<Window x:Class="MineOrbit.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Icon="Assets/MineOrbit.ico" Title="MineOrbit" Width="1180" Height="800" MinWidth="760" MinHeight="480" AllowDrop="True" Drop="OnDrop">
<Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,16,0"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource MineOrbitMark}" Width="30" Height="30" Margin="0,0,8,0"/><TextBlock Text="MineOrbit" FontSize="20" FontWeight="Bold" Foreground="#85E5A9" VerticalAlignment="Center"/></StackPanel><TextBlock Text="你的世界，由此出发" Foreground="#9AAEA4" Margin="0,6,0,18"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="0.4.0 · Windows x64" Foreground="#8B9F94" FontSize="11"/>
<ListBox x:Name="NavigationList" SelectedIndex="{Binding Page}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"><ListBox.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0"/></Style><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="4"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,1"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Margin="0" VerticalAlignment="Center"/></DataTemplate></Setter.Value></Setter></Style></ListBox.Resources><ListBoxItem Content="⌂  主页"/><ListBoxItem Content="▣  游戏版本"/><ListBoxItem Content="↓  下载 Minecraft"/><ListBoxItem Content="◇  Mods"/><ListBoxItem Content="▧  整合包"/><ListBoxItem Content="≡  下载任务"/><ListBoxItem Content="⚙  设置"/></ListBox></DockPanel>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="AccountHeader" MaxHeight="145" Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="登录 Microsoft" Command="{Binding LoginCommand}"/><Button Content="退出账号" Command="{Binding LogoutCommand}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><TextBlock Text="MINECRAFT JAVA EDITION" Foreground="#85E5A9" FontWeight="Bold"/><TextBlock Text="{Binding Account}" Foreground="#B7C6BD"/><TextBlock Text="{Binding DeviceInstructions}" Foreground="#F6CD72" Visibility="{Binding HasDevicePrompt, Converter={StaticResource BooleanVisibility}}"/><Button Content="打开 Microsoft 设备码验证页面" Command="{Binding OpenVerificationCommand}" Visibility="{Binding HasDevicePrompt, Converter={StaticResource BooleanVisibility}}"/></StackPanel></ScrollViewer></DockPanel>
<TabControl x:Name="MainPages" Foreground="{StaticResource Foreground}" Grid.Row="1" SelectedIndex="{Binding Page}" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Foreground}"/><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="MINEORBIT / YOUR NEXT WORLD" FontSize="11" FontWeight="Bold" Foreground="#7CDEBC"/><TextBlock Text="让下一段冒险，进入轨道。" FontSize="28" FontWeight="Bold"/><TextBlock Text="管理你的游戏版本、探索 Mods，或把整个世界带进来。" Foreground="#BCD5D6"/><WrapPanel><Button Content="＋ 安装游戏" Command="{Binding GoDownloadCommand}"/><Button Content="◇ 探索 Mods" Command="{Binding GoModsCommand}"/><Button Content="▧ 导入整合包" Command="{Binding GoImportCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前游戏版本" Foreground="#85E5A9"/><ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding Selected.Name, TargetNullValue=还没有游戏版本}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Selected.MinecraftVersion, StringFormat=游戏版本：{0}}"/><TextBlock Text="{Binding Selected.Loader, StringFormat=Mod Loader：{0}}"/><TextBlock Text="{Binding Selected.LoaderVersion}"/><TextBlock Text="{Binding IsolationDescription}" Foreground="#85E5A9"/><TextBlock Text="{Binding ActualGameDirectory}" Foreground="#A5BCAF"/><TextBlock Text="{Binding Selected.LastLaunched, StringFormat=最近启动：{0:g}}"/><Button Content="{Binding LaunchButtonLabel}" Command="{Binding LaunchCommand}" FontSize="20" Background="#237C65" Padding="24,18"/><TextBlock Text="启动前会刷新正版会话、检查 Java 并补齐游戏文件。" Foreground="#9FB3A7"/></StackPanel></Border>
<Border Style="{StaticResource Card}" BorderBrush="#579D76" BorderThickness="1"><StackPanel><TextBlock Text="拖入 ZIP 或 MRPACK 文件以安装整合包" FontSize="18"/><TextBlock Text="自动识别版本与 Loader，校验文件后创建全新独立游戏版本。"/><Button Content="选择整合包文件" Command="{Binding InspectPackCommand}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><TextBlock Text="游戏版本" FontSize="28"/><ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}" Height="260" Background="#16272F" Foreground="White"/><TextBox Text="{Binding Rename, UpdateSourceTrigger=PropertyChanged}" ToolTip="新的游戏版本名称"/><WrapPanel><Button Content="检查并修复游戏文件" Command="{Binding RepairGameCommand}"/><Button Content="复制独立游戏版本" Command="{Binding CopyInstanceCommand}"/><Button Content="备份存档与 Mods" Command="{Binding BackupCommand}"/><Button Content="启动" Command="{Binding LaunchCommand}"/><Button Content="重命名" Command="{Binding RenameCommand}"/><Button Content="打开文件夹" Command="{Binding OpenInstanceCommand}"/><Button Content="查看 Mods 文件夹" Command="{Binding OpenModsCommand}"/><Button Content="查看游戏日志" Command="{Binding OpenLogsCommand}"/><Button Content="移除配置（保留文件）" Command="{Binding RemoveCommand}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="版本隔离" FontSize="20" Foreground="#85E5A9"/>
<ComboBox ItemsSource="{Binding IsolationChoices}" SelectedItem="{Binding CurrentIsolation}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding ActualGameDirectory}"/>
<TextBlock Text="切换不会搬迁或删除已有文件，可随时切回。共享目录会限制不兼容 Mods 混装。"/><Button Content="应用隔离设置" Command="{Binding ApplyIsolationCommand}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><TextBlock Text="安装一个新的世界" FontSize="28"/><TextBlock Text="游戏版本名称"/><TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="获取 Minecraft 版本" Command="{Binding RefreshVersionsCommand}"/><CheckBox Content="包含 Snapshot" IsChecked="{Binding IncludeSnapshots}" VerticalAlignment="Center" Foreground="White"/></WrapPanel><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxDropDownHeight="300"/><TextBlock Text="Mod Loader"/><ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding SelectedLoader}"/><Button Content="获取此版本兼容的 Loader" Command="{Binding RefreshLoadersCommand}"/><ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding LoaderVersion}"/><TextBlock Text="{Binding InstallLocation}"/><TextBlock Text="版本隔离方式"/><ComboBox ItemsSource="{Binding IsolationChoices}" SelectedItem="{Binding NewIsolation}" IsEnabled="{Binding CanEdit}"/><Button Content="下载并创建游戏版本" Command="{Binding InstallCommand}" Background="#237C65"/><TextBlock Text="失败后可重试同一安装，复用已下载文件。安装成功之前不会加入游戏版本列表。"/></StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel>
<TextBlock Text="发现你的下一个 Mod" FontSize="28"/><TextBlock Text="下载渠道" Foreground="#7CDEBC"/><ComboBox ItemsSource="{Binding ModSources}" SelectedValuePath="Mode" SelectedValue="{Binding SelectedModSource}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding ModChannelHint}" Foreground="#9EB3BD"/><TextBlock Text="目标游戏版本（下载、更新、删除均作用于此游戏版本）" Foreground="#85E5A9"/>
<ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding ActualGameDirectory}"/>
<DockPanel><Button DockPanel.Dock="Right" Content="搜索兼容 Mod" Command="{Binding SearchModsCommand}"/><TextBox Text="{Binding ModQuery, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"/></DockPanel>
<ListBox ItemsSource="{Binding ModResults}" SelectedItem="{Binding SelectedModProject}" IsEnabled="{Binding CanEdit}" Height="165" Background="#16272F" Foreground="White"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="16" Margin="0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Source}" FontSize="11" Foreground="#7CDEBC" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="{Binding ModDescription}" MaxHeight="65"/><Button Content="查看兼容版本" Command="{Binding GetModVersionsCommand}"/><ComboBox ItemsSource="{Binding ModVersions}" SelectedItem="{Binding SelectedModVersion}" IsEnabled="{Binding CanEdit}"/>
<Button Content="安装所选版本及必要依赖" Command="{Binding InstallModCommand}" Background="#237C65"/>
<TextBlock Text="已安装 Mods" FontSize="21"/><Button Content="刷新已安装列表（含本地文件）" Command="{Binding RefreshModsCommand}"/>
<ListBox ItemsSource="{Binding InstalledMods}" SelectedItem="{Binding SelectedInstalledMod}" IsEnabled="{Binding CanEdit}" Height="165" Background="#16272F" Foreground="White"/>
<WrapPanel><Button Content="检查并更新" Command="{Binding UpdateModCommand}"/><Button Content="启用 / 禁用" Command="{Binding ToggleModCommand}"/><Button Content="删除 Mod" Command="{Binding RemoveModCommand}"/><Button Content="打开 Mods 文件夹" Command="{Binding OpenModsCommand}"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Text="整合包导入" FontSize="28"/><Border Style="{StaticResource Card}" BorderBrush="#579D76" BorderThickness="1"><StackPanel>
<TextBlock Text="拖入 ZIP / MRPACK" FontSize="23"/><TextBlock Text="支持 MRPACK、CurseForge ZIP、MultiMC / Prism 和完整文件 ZIP；识别外层目录与 .minecraft，独立安装并保留旧版本。"/><Button Content="选择压缩包" Command="{Binding InspectPackCommand}"/>
<TextBox Text="{Binding PackPath, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding PackResult}"/></StackPanel></Border>
<TextBlock Text="新游戏版本名称"/><TextBox Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="已识别的信息会自动填入。MRPACK、CurseForge、MultiMC / Prism 使用原清单；无清单 ZIP 请确认 Minecraft 和 Loader。"/>
<TextBlock Text="Minecraft 版本（例如 1.20.1）"/><TextBox Text="{Binding PackMinecraft, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Mod Loader / 具体版本"/><ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding PackLoader}"/><TextBox Text="{Binding PackLoaderVersion, UpdateSourceTrigger=PropertyChanged}"/>
<CheckBox Content="包含客户端可选文件" IsChecked="{Binding IncludeOptionalPackFiles}" Foreground="White" Margin="0,10"/>
<TextBlock Text="整合包强制独立隔离。CurseForge 下载需要授权 API Key；受限文件会明确报错。"/><Button Content="开始安装整合包" Command="{Binding ImportPackCommand}" Background="#237C65"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><TextBlock Text="当前任务" FontSize="28"/><TextBlock Text="{Binding Status}"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="12"/><Button Content="取消当前任务" Command="{Binding CancelCommand}"/><TextBox Text="{Binding History, Mode=OneWay}" IsReadOnly="True" Height="340" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden"/><TextBlock Text="取消只中止准备或安装阶段；已运行的游戏请在游戏中正常退出，以保护存档。"/><TextBlock Text="未完成安装（支持重启后恢复）" FontSize="20"/><Button Content="刷新未完成安装" Command="{Binding RefreshPendingCommand}"/><ListBox ItemsSource="{Binding PendingInstances}" SelectedItem="{Binding SelectedPendingInstance}" IsEnabled="{Binding CanEdit}" Height="120" Background="#16272F" Foreground="White"/><Button Content="继续所选安装" Command="{Binding ResumeInstallCommand}"/></StackPanel></ScrollViewer></TabItem>
<TabItem><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><TextBlock Text="设置" FontSize="28"/><TextBlock Text="游戏数据根目录（更改后显示新目录中的游戏版本，不自动搬迁文件）"/><TextBox Text="{Binding Settings.DataRoot, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="Java 路径（留空使用 CmlLib 自动安装的官方 Runtime）"/><TextBox Text="{Binding Settings.JavaPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><Button Content="检测本机 Java" Command="{Binding DetectJavaCommand}"/><ComboBox ItemsSource="{Binding JavaCandidates}" SelectedItem="{Binding SelectedJavaCandidate}"/><TextBlock Text="MineOrbit 应用 Client ID（已内置；自建应用可替换）"/><TextBox Text="{Binding Settings.MicrosoftClientId, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><Button Content="登录帮助 / Minecraft API 准入说明" Command="{Binding LoginHelpCommand}"/><TextBlock Text="登录方式"/><ComboBox ItemsSource="{Binding LoginModes}" SelectedValuePath="Mode" SelectedValue="{Binding Settings.LoginMode}"/><TextBlock Text="回调地址：http://localhost。点击登录或启动时会先保存并应用设置。"/><TextBlock Text="CurseForge API Key（可选，DPAPI 加密保存；已保存的 Key 不回显）"/><PasswordBox PasswordChanged="OnCurseKeyChanged" Padding="10" Margin="0,5,10,10"/><TextBlock Text="新游戏版本默认隔离模式"/><ComboBox ItemsSource="{Binding IsolationChoices}" SelectedValuePath="Mode" SelectedValue="{Binding Settings.DefaultIsolation}"/><TextBlock Text="整合包下载并发（1–16）"/><TextBox Text="{Binding Settings.DownloadConcurrency, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="最小 / 最大内存 MB"/><UniformGrid Columns="2"><TextBox Text="{Binding Settings.MinimumRamMb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBox Text="{Binding Settings.MaximumRamMb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></UniformGrid><TextBlock Text="游戏分辨率（宽 / 高）"/><UniformGrid Columns="2"><TextBox Text="{Binding Settings.Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBox Text="{Binding Settings.Height, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></UniformGrid><CheckBox Content="共享 Libraries / Assets / Java 缓存（游戏内容仍按隔离模式分开）" IsChecked="{Binding Settings.ShareRuntimeAndAssets}" Foreground="White" Margin="0,10"/><TextBlock Text="以下缓存目录留空时使用数据根目录下的默认位置。"/><TextBlock Text="Libraries 目录"/><TextBox Text="{Binding Settings.LibrariesPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="Assets 目录"/><TextBox Text="{Binding Settings.AssetsPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="Java Runtime 目录"/><TextBox Text="{Binding Settings.RuntimePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="Mod 下载缓存目录"/><TextBox Text="{Binding Settings.DownloadCachePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="界面语言：简体中文 · 主题：深色。运行依赖可共享，游戏目录按所选隔离模式决定。"/><Button Content="打开启动器日志" Command="{Binding OpenLauncherLogsCommand}"/></StackPanel></ScrollViewer></TabItem>
</TabControl>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0"><StackPanel>
<TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
<ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="3" Margin="0,3,0,5" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}"/><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↑" Click="PageUp" ToolTip="向上翻页" Padding="12,5"/><Button Content="↓" Click="PageDown" ToolTip="向下翻页" Padding="12,5"/><Button x:Name="PinnedLaunchButton" Content="{Binding LaunchButtonLabel}" Command="{Binding LaunchCommand}" Visibility="{Binding IsHomePage, Converter={StaticResource BooleanVisibility}}" Padding="18,7" MinWidth="130" MaxWidth="220" Background="#237C65"/><Button x:Name="PinnedSaveButton" Content="保存设置" Click="SaveVisibleSettings" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanVisibility}}" Padding="14,5" Background="#237C65"/></StackPanel><TextBlock Text="{Binding SettingsSaveHint}" Foreground="#A5BCAF" FontSize="12" Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanVisibility}}" VerticalAlignment="Center"/></DockPanel>
</StackPanel></Border>
</Grid></Grid></Window>
